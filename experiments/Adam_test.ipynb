   "source": [
    "import torch\n",
    "\n",
    "x = torch.tensor([3.0, 3.0], requires_grad=True)\n",
    "\n",
    "optimizer = torch.optim.Adam([x], lr=0.01)\n",
    "\n",
    "for t in range(1000):\n",
    "    optimizer.zero_grad()\n",
    "    loss = 0.5 * (x ** 2).sum()\n",
    "    loss.backward() # вычисление градиента\n",
    "    optimizer.step() # шаг Адамом"
   ],
